{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "installCommand": "echo 'Skipping root install'",
    "framework": null,
    "rewrites": [
        {
            "source": "/backend-status",
            "destination": "https://portfolio-capital-ten-member.trycloudflare.com/"
        },
        {
            "source": "/backend-status/",
            "destination": "https://portfolio-capital-ten-member.trycloudflare.com/"
        },
        {
            "source": "/backend-status/:path*",
            "destination": "https://portfolio-capital-ten-member.trycloudflare.com/:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "https://portfolio-capital-ten-member.trycloudflare.com/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}