{
    "version": 2,
    "rewrites": [
        {
            "source": "/backend-status",
            "destination": "https://tradeverse-1-aosu.onrender.com/"
        },
        {
            "source": "/backend-status/",
            "destination": "https://tradeverse-1-aosu.onrender.com/"
        },
        {
            "source": "/backend-status/:path*",
            "destination": "https://tradeverse-1-aosu.onrender.com/:path*"
        },
        {
